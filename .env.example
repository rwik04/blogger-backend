OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Researcher agent ----------------------------------------------------
EXA_API_KEY=
RESEARCHER_MAX_ITERATIONS=3

# --- Strategist agent ------------------------------------------------------
# "low" | "medium" | "high" — kept low by default since keyword/outline
# drafting is a small, well-grounded task, not one needing deep reasoning.
STRATEGIST_REASONING_EFFORT=low

# --- Writer agent ------------------------------------------------------
# "low" | "medium" | "high" — higher than the Strategist's since this call
# produces the actual blog content (draft + fact-check + humanize per call).
WRITER_REASONING_EFFORT=medium

# --- Finisher agent ------------------------------------------------------
# "low" | "medium" | "high" — used for both LLM calls (candidate-question
# generation, media-prompt generation).
FINISHER_REASONING_EFFORT=medium
# Default for whether the Finisher generates the UPSC-style quiz at all —
# overridable per run via `--quiz`/`--no-quiz` on the `finish` CLI.
FINISHER_GENERATE_QUIZ=true
# Google Images (via SerpAPI) — resolves each banner/infographic prompt to a
# real image URL. Optional: leave blank to skip image resolution entirely
# (media prompts are still generated/persisted, just without image_url).
SERPAPI_API_KEY=

# --- Topic Generator agent -----------------------------------------------
# "low" | "medium" | "high" — kept low by default, same reasoning as the
# Strategist's: extraction/classification here are small, batched LLM calls.
TOPIC_GENERATOR_REASONING_EFFORT=low

# --- Daily topic cron (in-process, api/scheduler.py) ----------------------
# Off by default so it never fires unexpectedly in local dev — set to
# "true" only on the deployed instance.
TOPIC_CRON_ENABLED=false
# UTC hour (0-23) the daily autonomous batch runs at.
TOPIC_CRON_HOUR_UTC=3
# Candidates extracted across all subjects before trimming (wide net).
TOPIC_CRON_COUNT=18
# Highest-relevance candidates kept after trimming (the day's actual output).
TOPIC_CRON_MAX_OUTPUT=5

# --- Database (AWS RDS Postgres) ---------------------------------------
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# --- Connection pool tuning (defaults shown, override if needed) -------
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- CORS ------------------------------------------------------------------
# Comma-separated list of extra allowed browser origins, on top of the
# built-in localhost:3000/127.0.0.1:3000 dev origins. Set this to the
# deployed frontend's public URL (e.g. http://your-ec2-host:3000).
CORS_EXTRA_ORIGINS=
