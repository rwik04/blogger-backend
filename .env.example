OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Researcher agent ----------------------------------------------------
EXA_API_KEY=
RESEARCHER_MAX_ITERATIONS=3

# --- Strategist agent ------------------------------------------------------
# "low" | "medium" | "high" — kept low by default since keyword/outline
# drafting is a small, well-grounded task, not one needing deep reasoning.
STRATEGIST_REASONING_EFFORT=low

# --- Writer agent ------------------------------------------------------
# "low" | "medium" | "high" — higher than the Strategist's since this call
# produces the actual blog content (draft + fact-check + humanize per call).
WRITER_REASONING_EFFORT=medium

# --- Finisher agent ------------------------------------------------------
# "low" | "medium" | "high" — used for both LLM calls (candidate-question
# generation, media-prompt generation).
FINISHER_REASONING_EFFORT=medium
# Default for whether the Finisher generates the UPSC-style quiz at all —
# overridable per run via `--quiz`/`--no-quiz` on the `finish` CLI.
FINISHER_GENERATE_QUIZ=true

# --- Database (AWS RDS Postgres) ---------------------------------------
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# --- Connection pool tuning (defaults shown, override if needed) -------
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
